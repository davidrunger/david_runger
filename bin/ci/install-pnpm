#!/usr/bin/env bash

# Install the exact pnpm version recorded in pnpm-lock.yaml for CI.

set -euo pipefail # exit on any error, don't allow undefined variables, pipes don't swallow errors

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
lockfile_path="$repository_root/pnpm-lock.yaml"

pnpm_version="$(
  awk '
    /^    packageManagerDependencies:/ {in_package_manager_dependencies=1; next}
    in_package_manager_dependencies && /^packages:/ {exit}
    in_package_manager_dependencies && /^      pnpm:/ {in_pnpm=1; next}
    in_pnpm && /^        version:[[:space:]]/ {print $2; exit}
  ' "$lockfile_path"
)"

if [ -z "$pnpm_version" ]; then
  echo "Could not determine pnpm version from $lockfile_path." >&2
  exit 1
fi

npm install -g "pnpm@$pnpm_version"
