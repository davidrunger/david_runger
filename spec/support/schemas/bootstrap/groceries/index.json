{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$ref": "#/definitions/Root",
  "definitions": {
    "Root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nonce": {
          "type": "string",
          "format": "uuid"
        },
        "current_user": {
          "$ref": "#/definitions/CurrentUser"
        },
        "alert_toast_messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notice_toast_messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spouse": {
          "anyOf": [
            {
              "$ref": "#/definitions/CurrentUser"
            },
            {
              "type": "null"
            }
          ]
        },
        "own_stores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Store"
          }
        },
        "spouse_stores": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Store"
          }
        }
      },
      "required": [
        "current_user",
        "nonce",
        "own_stores",
        "spouse",
        "spouse_stores"
      ],
      "title": "Root"
    },
    "CurrentUser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      },
      "required": ["email", "id"],
      "title": "CurrentUser"
    },
    "Store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "own_store": {
          "type": "boolean"
        },
        "private": {
          "type": "boolean"
        },
        "viewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "section_configuration": {
          "anyOf": [
            { "$ref": "#/definitions/StoreSectionConfiguration" },
            { "type": "null" }
          ]
        },
        "item_section_assignments": {
          "type": "array",
          "items": { "$ref": "#/definitions/ItemSectionAssignment" }
        }
      },
      "required": [
        "id",
        "item_section_assignments",
        "items",
        "name",
        "notes",
        "own_store",
        "private",
        "section_configuration",
        "viewed_at"
      ],
      "title": "Store"
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "needed": {
          "type": "integer"
        },
        "store_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": ["id", "name", "needed", "store_ids"],
      "title": "Item"
    },
    "ItemSectionAssignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "integer" },
        "store_section_id": { "type": "integer" }
      },
      "required": ["item_id", "store_section_id"],
      "title": "ItemSectionAssignment"
    },
    "StoreSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"],
      "title": "StoreSection"
    },
    "StoreSectionConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectioning_enabled": { "type": "boolean" },
        "store_section_scheme": {
          "anyOf": [
            { "$ref": "#/definitions/StoreSectionScheme" },
            { "type": "null" }
          ]
        }
      },
      "required": ["sectioning_enabled", "store_section_scheme"],
      "title": "StoreSectionConfiguration"
    },
    "StoreSectionScheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "store_sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/StoreSection" }
        }
      },
      "required": ["id", "name", "store_sections"],
      "title": "StoreSectionScheme"
    }
  }
}
